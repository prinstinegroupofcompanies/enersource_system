# sqlite (local dev) | postgresql (production on Render)
DATABASE_PROVIDER=sqlite
DATABASE_URL="file:./dev.db"

# PostgreSQL (Render — auto-injected when database is linked):
# DATABASE_PROVIDER=postgresql
# DATABASE_URL="postgresql://user:password@host:5432/enersource_erp"

JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_REFRESH_SECRET=change-this-refresh-secret-too
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Production: set to your Vercel URL (comma-separated for preview + production)
# CLIENT_URL=https://enersource.vercel.app,https://enersource-*.vercel.app

# Password policy
PASSWORD_MIN_LENGTH=10
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SPECIAL=true

# MFA issuer name shown in authenticator apps
MFA_ISSUER=Enersource ERP
